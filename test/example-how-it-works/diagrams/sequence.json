{
 "view": "sequence",
 "title": "Sequence: one audited model call, then the report",
 "caption": "Steps 1-4 repeat for every model call in every run; steps 5-9 run once at the end.",
 "participants": [
  {
   "id": "agent",
   "kind": "service",
   "name": "Your agent",
   "tech": "anthropic SDK"
  },
  {
   "id": "proxy",
   "kind": "service",
   "name": "usage_proxy.py",
   "tech": "Python"
  },
  {
   "id": "api",
   "kind": "external",
   "name": "Messages API",
   "tech": "HTTPS"
  },
  {
   "id": "trace",
   "kind": "storage",
   "name": "Trace files",
   "tech": "JSONL"
  },
  {
   "id": "analyze",
   "kind": "service",
   "name": "analyze_trace.py",
   "tech": "Python"
  },
  {
   "id": "claude",
   "kind": "service",
   "name": "Claude Code",
   "tech": "skill"
  },
  {
   "id": "build",
   "kind": "service",
   "name": "build_report.py",
   "tech": "Python"
  }
 ],
 "messages": [
  {
   "from": "agent",
   "to": "proxy",
   "label": "POST /v1/messages",
   "step": "1"
  },
  {
   "note": "Over budget? Record the call and answer 400 (no retry)",
   "over": "proxy"
  },
  {
   "from": "proxy",
   "to": "api",
   "label": "forward, Accept-Encoding: identity",
   "step": "2"
  },
  {
   "from": "api",
   "to": "proxy",
   "label": "response + usage (JSON or SSE)",
   "return": true
  },
  {
   "from": "proxy",
   "to": "trace",
   "label": "append record",
   "step": "3"
  },
  {
   "from": "proxy",
   "to": "agent",
   "label": "same bytes, unchanged",
   "return": true,
   "step": "4"
  },
  {
   "from": "analyze",
   "to": "trace",
   "label": "load each run",
   "step": "5"
  },
  {
   "from": "analyze",
   "to": "claude",
   "label": "findings (leads, not verdicts)",
   "step": "6"
  },
  {
   "from": "claude",
   "to": "claude",
   "label": "confirm in code, compute waste",
   "step": "7"
  },
  {
   "from": "claude",
   "to": "build",
   "label": "token-audit.json",
   "step": "8"
  },
  {
   "from": "build",
   "to": "claude",
   "label": "report.html, or missing fields",
   "return": true,
   "step": "9"
  }
 ],
 "frames": [
  {
   "type": "loop",
   "label": "every model call, 3+ runs",
   "start": 0,
   "end": 5
  },
  {
   "type": "opt",
   "label": "under budget",
   "start": 2,
   "end": 5
  }
 ]
}