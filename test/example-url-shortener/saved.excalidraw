    {
      "id": "aFyS0YXTlJ_9BJ1-NrXpz",
      "type": "text",
      "x": -25264.38279606892,
      "y": 14612.382528110196,
      "width": 449.3878173828125,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
