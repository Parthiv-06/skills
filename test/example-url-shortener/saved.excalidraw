    {
      "id": "spkssWacn4e_w9bpto2jW",
      "type": "text",
      "x": -32406.466424371574,
      "y": 6472.792650109959,
      "width": 1909.3986537975468,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6k",
      "roundness": null,
      "seed": 1046362870,
      "version": 133,
      "versionNonce": 1753915818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794309161468,
      "created": 1794309140087,
      "link": null,
      "locked": false,
      "text": "| Check | If it fails |\n| --- | --- |\n| The bundle can be stored, and CONTRACTS_BUCKET is set | Error |\n| The contract already exists and you didn't ask to replace it | \"Already stored, ask whether to replace\" |\n| Supplier tenders or validations depend on the stored contract | Replacing is refused |\n| Every unit, frequency and cost-role code exists in its lookup table | Error naming the missing codes (an\noperator runs seed_reference.py) |\n| The dataset's columns match the agent's schema (INFORMATION_SCHEMA) | Error naming the migration\nto run |",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Check | If it fails |\n| --- | --- |\n| The bundle can be stored, and CONTRACTS_BUCKET is set | Error |\n| The contract already exists and you didn't ask to replace it | \"Already stored, ask whether to replace\" |\n| Supplier tenders or validations depend on the stored contract | Replacing is refused |\n| Every unit, frequency and cost-role code exists in its lookup table | Error naming the missing codes (an operator runs seed_reference.py) |\n| The dataset's columns match the agent's schema (INFORMATION_SCHEMA) | Error naming the migration to run |",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
