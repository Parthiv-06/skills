      "type": "text",
      "x": -25593.686579579426,
      "y": 9300.76845525342,
      "width": 805.6437377929688,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5bV",
      "roundness": null,
      "seed": 484613418,
      "version": 40,
      "versionNonce": 172846838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794305875305,
      "created": 1794305860474,
      "link": null,
      "locked": false,
      "text": "plan_load finds a header row containing a\nname column, a period column and a value\ncolumn.\nIt matches index names against\nmarket_index rows from stored contracts.\nUnknown names, unit mismatches and\nduplicate months are reported as not_loaded.\nThere is no automatic check that a\nspreadsheet is an index file rather than a\ncost model. The only guards are the user's\nwording and the cost-model reader's\nis_cost_model=false.",
      "fontSize": 36,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "UTizp5FnSFBdC0oWoKS0Z",
      "originalText": "plan_load finds a header row containing a name column, a period column and a value column.\nIt matches index names against market_index rows from stored contracts. Unknown names, unit mismatches and duplicate months are reported as not_loaded.\nThere is no automatic check that a spreadsheet is an index file rather than a cost model. The only guards are the user's wording and the cost-model reader's is_cost_model=false.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "18XzKASP4HVGpSNuXhV4w",
