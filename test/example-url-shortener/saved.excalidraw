      "seed": 488932022,
      "version": 3,
      "versionNonce": 207402614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794305622925,
      "created": 1794305622180,
      "link": null,
      "locked": false,
      "text": "The cost model's xlsx is\nnot copied to any\npermanent bucket by this\ncode. It stays in the\nattachments bucket,\nwhich the contract-agent\nnotes say deletes after\n7 days. Only its name and\nhash survive in BigQuery.",
      "fontSize": 36,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "uve3iQ8r9EffaEVBN1BVD",
      "originalText": "The cost model's xlsx is not copied to any permanent bucket by this code. It stays in the attachments bucket, which the contract-agent notes say deletes after 7 days. Only its name and hash survive in BigQuery.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
