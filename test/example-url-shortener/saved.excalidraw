    {
      "id": "lEtVObCHOBbA5j1CCAmbj",
      "type": "text",
      "x": 4138.436753023176,
      "y": -329.56029020610725,
      "width": 287.311767578125,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0AV",
      "roundness": null,
      "seed": 1773195729,
      "version": 6,
      "versionNonce": 673837201,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793077996534,
      "created": 1793077969144,
      "link": null,
      "locked": false,
      "text": " It rejects a plan with:\n\nan unknown agent, a duplicate ID, or\na step that waits on a step that\ndoesn't exist;\na loop;\ntoo many steps or too deep a chain;\na step whose input nothing earlier\nproduces;\nany agent that writes. Writes stay\nbehind the existing manager-approval\nchain.",
      "fontSize": 16,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "kJN4HOHRXFXkcHzYKc2h6",
      "originalText": " It rejects a plan with:\n\nan unknown agent, a duplicate ID, or a step that waits on a step that doesn't exist;\na loop;\ntoo many steps or too deep a chain;\na step whose input nothing earlier produces;\nany agent that writes. Writes stay behind the existing manager-approval chain.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
