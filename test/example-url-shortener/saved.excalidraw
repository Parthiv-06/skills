    {
      "id": "TvmWuhYSqvRHtHmUr5KAT",
      "type": "text",
      "x": -31826.67346577764,
      "y": 8619.013007173466,
      "width": 693.7198486328125,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6RV",
      "roundness": null,
      "seed": 1709648118,
      "version": 97,
      "versionNonce": 1627585718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794308513153,
      "created": 1794308467786,
      "link": null,
      "locked": false,
      "text": "Settings: gemini-3.5-flash at location\nglobal, temperature 0, JSON output\nagainst the schema,\nmax_output_tokens 65,536, and\nHTTP retries on 429 and 5xx errors.\nOn a cut-off answer: if a call stops at\nMAX_TOKENS, it is asked again once\nwith thinking capped at\nEXTRACTION_THINKING_BUDGET\n(16,384 tokens). If the second answer\nis also cut off, the user gets an error. \nRule for the model: the prompts tell it\nto copy values exactly as printed and\nnever calculate. Text inside the PDF is\ntreated as data, not instructions.",
      "fontSize": 36,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "q-Dp4ds8OJn6-9hjwNvx_",
      "originalText": "Settings: gemini-3.5-flash at location global, temperature 0, JSON output against the schema, max_output_tokens 65,536, and HTTP retries on 429 and 5xx errors.\nOn a cut-off answer: if a call stops at MAX_TOKENS, it is asked again once with thinking capped at EXTRACTION_THINKING_BUDGET (16,384 tokens). If the second answer is also cut off, the user gets an error. \nRule for the model: the prompts tell it to copy values exactly as printed and never calculate. Text inside the PDF is treated as data, not instructions.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
