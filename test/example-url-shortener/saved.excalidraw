    {
      "id": "uOMU_C2ftgpmtQh19Ldg1",
      "type": "text",
      "x": -25385.915648302427,
      "y": 13761.047982904802,
      "width": 524.849853515625,
      "height": 487.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5L",
      "roundness": null,
      "seed": 206459754,
      "version": 3,
      "versionNonce": 1495027306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794305260869,
      "created": 1794305259599,
      "link": null,
      "locked": false,
      "text": "The contract_id argument, if the\nuser gave one.\nThe contract ID printed in the file,\nwhich must be a stored contract.\nOtherwise the file's product code.\nIt looks up stored contracts\ncovering that product, filtered by\nvendor code or vendor name.\nOne contract matching means it\nuses that one.\nSeveral matching means it asks the\nuser which.\nNone matching is an error.",
      "fontSize": 30,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "WahiGYGlybwIO5h0Q9sIr",
      "originalText": "The contract_id argument, if the user gave one.\nThe contract ID printed in the file, which must be a stored contract.\nOtherwise the file's product code. It looks up stored contracts covering that product, filtered by vendor code or vendor name.\nOne contract matching means it uses that one.\nSeveral matching means it asks the user which.\nNone matching is an error.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
