    {
      "id": "eoQb9BoESeN5msBldsFLu",
      "type": "text",
      "x": -36619.6109021234,
      "y": 6677.2900485288665,
      "width": 1619.819580078125,
      "height": 765,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6l8",
      "roundness": null,
      "seed": 1173143722,
      "version": 15,
      "versionNonce": 2107524906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794309277217,
      "created": 1794309256999,
      "link": null,
      "locked": false,
      "text": "Tables\n\n\n| Group | Tables |\n| --- | --- |\n| Shared (added once, never changed) | organization, facility, product, component,\nmarket_index |\n| Contract | contract, contract_party, contract_document |\n| Calendar | pricing_period, contract_change_frequency, contract_change_frequency_period |\n| Products and pricing | contract_product, contract_product_component, pricing_term,\npricing_term_index_leg, pricing_term_tier, price_build_step |\n| Adjustments | contract_adjustment, contract_adjustment_tier |\n| Freight | freight_bracket, freight_lane, freight_rate |\n| Baseline cost model | cost_model, cost_model_line, cost_model_freight |\n| The PDF | GCS contracts/<contract_id>/<file> |\n\n",
      "fontSize": 36,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "HG20oK5_gmsKFyCJAuZGn",
      "originalText": "Tables\n\n\n| Group | Tables |\n| --- | --- |\n| Shared (added once, never changed) | organization, facility, product, component, market_index |\n| Contract | contract, contract_party, contract_document |\n| Calendar | pricing_period, contract_change_frequency, contract_change_frequency_period |\n| Products and pricing | contract_product, contract_product_component, pricing_term, pricing_term_index_leg, pricing_term_tier, price_build_step |\n| Adjustments | contract_adjustment, contract_adjustment_tier |\n| Freight | freight_bracket, freight_lane, freight_rate |\n| Baseline cost model | cost_model, cost_model_line, cost_model_freight |\n| The PDF | GCS contracts/<contract_id>/<file> |\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ZlLRsIqci2Dlxk36YMyty",
      "type": "stickynote",
      "x": -34544.33094208503,
      "y": 6271.077845738161,
      "width": 1646.549501093371,
      "height": 1646.549501093371,
