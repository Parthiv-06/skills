    {
      "id": "5wQNy6RZfXIBZQa4XELdC",
      "type": "text",
      "x": -23772.36970274309,
      "y": 10201.387364519764,
      "width": 1201.211669921875,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5hG",
      "roundness": null,
      "seed": 1293074538,
      "version": 7,
      "versionNonce": 1919761322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794305938399,
      "created": 1794305934819,
      "link": null,
      "locked": false,
      "text": "GE \"+\" → A2A FilePart(bytes)\n  → inline_data(display_name)\n  → SaveFilesAsArtifacts → gs://ATTACHMENTS/app/<user>/\n<session>/<file>/<ver>\n  → attachment_index (state) → A2A metadata cmi.attachments\n(whole list, every call)\n  → specialist temp:cmi_attachments\n  → filter by type: PDF → contract agent | spreadsheet →\nvalidation agent\n  → contract PDF   → gs://CONTRACTS/contracts/<contract_id>/\n<file> + BQ rows\n  → cost model     → BQ submission_file + cost_model rows, linked\nby id/product/period\n  → index values   → BQ index rows",
      "fontSize": 36,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "18XzKASP4HVGpSNuXhV4w",
      "originalText": "GE \"+\" → A2A FilePart(bytes)\n  → inline_data(display_name)\n  → SaveFilesAsArtifacts → gs://ATTACHMENTS/app/<user>/<session>/<file>/<ver>\n  → attachment_index (state) → A2A metadata cmi.attachments (whole list, every call)\n  → specialist temp:cmi_attachments\n  → filter by type: PDF → contract agent | spreadsheet → validation agent\n  → contract PDF   → gs://CONTRACTS/contracts/<contract_id>/<file> + BQ rows\n  → cost model     → BQ submission_file + cost_model rows, linked by id/product/period\n  → index values   → BQ index rows",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
