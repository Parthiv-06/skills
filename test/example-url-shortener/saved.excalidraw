      "updated": 1794292773174,
      "created": 1794292540267,
      "link": null,
      "locked": false,
      "text": "SavefileasArtifactsPlugin:\n\n\n display name\n\nWrite: artifact_service.save_artifact(app_name=\"app\",\nuser_id, session_id, filename, part). The service is\nGcsArtifactService(ATTACHMENTS_BUCKET)\n\nObject path: gs://<ATTACHMENTS_BUCKET>/app/\n{user_id}/{session_id}/{filename}/{version}\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "8I8dCv4RAKOhQVdomWnpL",
      "originalText": "SavefileasArtifactsPlugin:\n\n\n display name\n\nWrite: artifact_service.save_artifact(app_name=\"app\", user_id, session_id, filename, part). The service is GcsArtifactService(ATTACHMENTS_BUCKET)\n\nObject path: gs://<ATTACHMENTS_BUCKET>/app/{user_id}/{session_id}/{filename}/{version}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
