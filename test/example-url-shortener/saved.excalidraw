    },
    {
      "id": "s-3KKuW2nOsuNOf_K0JA9",
      "type": "text",
      "x": -34506.62998304225,
      "y": 6734.352596284847,
      "width": 1571.1475830078125,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6y",
      "roundness": null,
      "seed": 343802282,
      "version": 12,
      "versionNonce": 1652329258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794309326877,
      "created": 1794309313829,
      "link": null,
      "locked": false,
      "text": "Guards\n\n\n| Risk | Guard |\n| --- | --- |\n| Text inside the PDF acting as instructions | The model has no tools during extraction,\nthe prompt treats the text as data, and the output must match a schema |\n| The model inventing or calculating values | \"Copy exactly\" prompts; numbers not found in\nthe PDF are listed as points to check |\n| Storing without your consent | StoreGuard: plain yes, in a later turn |\n| The file changing between extract and store | SHA-256 compared again at store time |\n| Partly stored contracts | One BigQuery transaction |\n| Duplicate vendors or products | Stable IDs from business keys |\n| Breaking validations that depend on a contract | Replacing is refused once tenders or\nvalidations exist |\n| Reading files it shouldn't | Only the configured attachments bucket can be read |",
      "fontSize": 36,
      "baseFontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ZlLRsIqci2Dlxk36YMyty",
      "originalText": "Guards\n\n\n| Risk | Guard |\n| --- | --- |\n| Text inside the PDF acting as instructions | The model has no tools during extraction, the prompt treats the text as data, and the output must match a schema |\n| The model inventing or calculating values | \"Copy exactly\" prompts; numbers not found in the PDF are listed as points to check |\n| Storing without your consent | StoreGuard: plain yes, in a later turn |\n| The file changing between extract and store | SHA-256 compared again at store time |\n| Partly stored contracts | One BigQuery transaction |\n| Duplicate vendors or products | Stable IDs from business keys |\n| Breaking validations that depend on a contract | Replacing is refused once tenders or validations exist |\n| Reading files it shouldn't | Only the configured attachments bucket can be read |",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "id6L6Fn4hA3TR52VEtoTZ",
      "type": "text",
      "x": -38631.452473330086,
      "y": 9079.358006916062,
      "width": 3703.89851576693,
      "height": 1111.8820319662866,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6z",
      "roundness": null,
      "seed": 1101943018,
      "version": 162,
      "versionNonce": 787192694,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794311047190,
      "created": 1794311025586,
      "link": null,
      "locked": false,
      "text": "User (GE)          Orchestrator         Validation agent                          BigQuery cost_model_dev\n   │ attach xlsx +     │                     │                                          │\n   │ \"check this\" ────▶│ save file to GCS,   │                                          │\n   │                   │ route over A2A ────▶│ A  read_cost_model                       │\n   │                   │                     │    read cells → Gemini → verify → link ─▶│ (reads contract tables)\n   │◀──── summary + \"Can I store this cost model?\" ─────────────────────────────────────│\n   │ \"yes\" ───────────────────────────────▶│ B  store_cost_model (WriteGuard)         │\n   │                                         │    one transaction ──────────────────────▶│ submission_file, cost_model,\n   │                                         │                                          │ lines, freight (RECEIVED)\n   │◀──── \"Stored. Check it now?\" ───────────│                                          │\n   │ \"yes\" ───────────────────────────────▶│ D  validate_cost_model                   │\n   │                                         │    4 queries on the check views (C) ─────▶│ views compute everything at query time\n   │◀──── FOB, findings, delivered prices, \"Save these findings?\" ─────────────────────│\n   │ \"yes\" ───────────────────────────────▶│ E  store_validation (WriteGuard)         │\n   │                                         │    re-check, compare fingerprint, write ──▶│ validation_run, validation_finding,\n   │                                         │                                          │ cost_model → VALIDATED\n   │ \"why is 3 flagged?\" / \"resolve 3\" / \"approve\" ▶ F  explain / resolve / decide ──────▶│",
      "fontSize": 52.32386032782524,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User (GE)          Orchestrator         Validation agent                          BigQuery cost_model_dev\n   │ attach xlsx +     │                     │                                          │\n   │ \"check this\" ────▶│ save file to GCS,   │                                          │\n   │                   │ route over A2A ────▶│ A  read_cost_model                       │\n   │                   │                     │    read cells → Gemini → verify → link ─▶│ (reads contract tables)\n   │◀──── summary + \"Can I store this cost model?\" ─────────────────────────────────────│\n   │ \"yes\" ───────────────────────────────▶│ B  store_cost_model (WriteGuard)         │\n   │                                         │    one transaction ──────────────────────▶│ submission_file, cost_model,\n   │                                         │                                          │ lines, freight (RECEIVED)\n   │◀──── \"Stored. Check it now?\" ───────────│                                          │\n   │ \"yes\" ───────────────────────────────▶│ D  validate_cost_model                   │\n   │                                         │    4 queries on the check views (C) ─────▶│ views compute everything at query time\n   │◀──── FOB, findings, delivered prices, \"Save these findings?\" ─────────────────────│\n   │ \"yes\" ───────────────────────────────▶│ E  store_validation (WriteGuard)         │\n   │                                         │    re-check, compare fingerprint, write ──▶│ validation_run, validation_finding,\n   │                                         │                                          │ cost_model → VALIDATED\n   │ \"why is 3 flagged?\" / \"resolve 3\" / \"approve\" ▶ F  explain / resolve / decide ──────▶│",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
