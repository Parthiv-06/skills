      "updated": 1794293101550,
      "created": 1794293050946,
      "link": null,
      "locked": false,
      "text": "The model calls transfer_to_agent to a\nRemoteA2aAgent proxy.\n\nThat proxy runs user_message_only\n(remote_agents.py). It forwards only the user's\nlatest message text, which includes the\n[Uploaded Artifact: \"x.pdf\"] placeholder, never\nthe bytes.\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "vzveGQ2s-5vmTLbI8mr-9",
      "originalText": "The model calls transfer_to_agent to a RemoteA2aAgent proxy.\n\nThat proxy runs user_message_only (remote_agents.py). It forwards only the user's latest message text, which includes the [Uploaded Artifact: \"x.pdf\"] placeholder, never the bytes.\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
