  {
   "name": "v_customer_ltv",
   "kind": "view",
   "columns": [
    {
     "name": "customer_id",
     "type": "INTEGER",
     "nullable": true
    },
    {
     "name": "email",
     "type": "TEXT",
     "nullable": true
    },
    {
     "name": "lifetime_cents",
     "type": "",
     "nullable": true
    }
   ],
   "primary_key": [],
   "unique": [],
   "foreign_keys": [],
   "indexes": [],
   "sql": "SELECT c.customer_id, c.email, COALESCE(SUM(t.total_cents), 0) AS lifetime_cents\nFROM customers c\nLEFT JOIN v_order_totals t ON t.customer_id = c.customer_id\nGROUP BY c.customer_id, c.email"
  },
  {
   "name": "v_order_totals",
   "kind": "view",
   "columns": [
    {
     "name": "order_id",
     "type": "INTEGER",
     "nullable": true
    },
    {
     "name": "customer_id",
     "type": "INTEGER",
     "nullable": true
    },
    {
     "name": "total_cents",
     "type": "",
     "nullable": true
    }
   ],
   "primary_key": [],
   "unique": [],
   "foreign_keys": [],
   "indexes": [],
   "sql": "SELECT o.order_id, o.customer_id, SUM(oi.quantity * oi.unit_price_cents) AS total_cents\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.order_id\nGROUP BY o.order_id, o.customer_id"
  }
 ],
 "indexes_known": true
