   "sql": "SELECT c.customer_id, c.email, COALESCE(SUM(t.total_cents), 0) AS lifetime_cents\nFROM customers c\nLEFT JOIN v_order_totals t ON t.customer_id = c.customer_id\nGROUP BY c.customer_id, c.email",
   "pk_source": "none",
   "junction": false,
   "grain_draft": "derived (a view): see what it reads",
