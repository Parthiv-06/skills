  {
   "name": "v_daily_active",
   "kind": "view",
   "columns": [],
   "primary_key": [],
   "unique": [],
   "foreign_keys": [],
   "indexes": [],
   "sql": "SELECT DATE(event_ts) AS day, COUNT(DISTINCT user_id) AS dau\nFROM `acme.analytics.events_*`\nGROUP BY day"
  },
  {
   "name": "v_user_revenue",
   "kind": "view",
   "columns": [],
   "primary_key": [],
   "unique": [],
   "foreign_keys": [],
   "indexes": [],
   "sql": "SELECT u.user_id, u.country, SUM(p.amount) AS revenue\nFROM `acme.analytics.users` AS u\nLEFT JOIN `acme.analytics.purchases` AS p ON p.user_id = u.user_id\nGROUP BY u.user_id, u.country"
  },
  {
   "name": "v_country_revenue",
   "kind": "view",
   "columns": [],
   "primary_key": [],
   "unique": [],
   "foreign_keys": [],
   "indexes": [],
   "sql": "SELECT r.country, SUM(r.revenue) AS revenue, COUNT(*) AS users\nFROM `acme.analytics.v_user_revenue` r\nGROUP BY r.country"
  }
